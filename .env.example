# Riot Games API key (Development keys expire every 24h — regenerate at
# https://developer.riotgames.com). Never commit a real key.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Routing region for match-v5 / account-v1 endpoints: americas | europe | asia
RIOT_ROUTING_REGION=americas

# Roster to display: gameName#tagLine:platform, semicolon-separated.
# platform is the summoner/league platform code (NA1, LAN, EUW1, KR, etc).
ROAST_PLAYERS="4H patitoZerone#404:LAN;4H nonamebot#168:LAN"

# Site copy — team identity and links
TEAM_NAME=4Hope
TEAM_TAGLINE="PLAY FOR KEEPS"
TEAM_DESCRIPTION="Good vibes, camaraderie, a little luck — that's 4Hope. TFT and League, always together."
DISCORD_URL=https://discord.gg/your-invite

# Hero section copy
HERO_KICKER="// TFT + League"
HERO_HEADING_LINE_1=Play
HERO_HEADING_LINE_2="for keeps"

# Firebase Admin SDK (server-only — used by the Leaderboard tool's room sync
# API routes). NEVER prefix these with NEXT_PUBLIC_ or expose them client-side.
# Get these from Firebase Console > Project settings > Service accounts >
# Generate new private key (downloads a JSON file with these three fields).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the JSON file as-is, including \n escapes,
# wrapped in double quotes.
FIREBASE_PRIVATE_KEY=""
