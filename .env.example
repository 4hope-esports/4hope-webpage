# Riot Games API key (Development keys expire every 24h — regenerate at
# https://developer.riotgames.com). Never commit a real key.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Routing region for match-v5 / account-v1 endpoints: americas | europe | asia
RIOT_ROUTING_REGION=americas

# Roster to display: gameName#tagLine:platform, semicolon-separated.
# platform is the summoner/league platform code (NA1, LAN, EUW1, KR, etc).
ROAST_PLAYERS="4H patitoZerone#404:LAN;4H nonamebot#168:LAN"

# Minimum seconds between manual Riot account refreshes. Defaults to 180 (3 minutes) if unset.
# Must be duplicated as NEXT_PUBLIC_ so the client-side countdown matches the server's limit.
RIOT_REFRESH_COOLDOWN_SECONDS=180
NEXT_PUBLIC_RIOT_REFRESH_COOLDOWN_SECONDS=180

# Site copy — team identity and links
TEAM_NAME=4Hope
TEAM_TAGLINE="PLAY FOR KEEPS"
TEAM_DESCRIPTION="Good vibes, camaraderie, a little luck — that's 4Hope. TFT and League, always together."

# Public Discord invite link — safe to expose client-side (used by pages
# that render as Client Components, like the error boundary).
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# Hero section copy
HERO_KICKER="// TFT + League"
HERO_HEADING_LINE_1=Play
HERO_HEADING_LINE_2="for keeps"

# Deployment environment: "production" | "uat". Anything other than
# "production" reads/writes Firestore collections suffixed with "-uat"
# (e.g. users-uat) so dev/uat traffic never touches prod data.
APP_ENV=uat

# Firebase Admin SDK (server-only — used by the Leaderboard tool's room sync
# API routes and the live user-count stat). NEVER prefix these with
# NEXT_PUBLIC_ or expose them client-side.
# Get these from Firebase Console > Project settings > Service accounts >
# Generate new private key (downloads a JSON file with these three fields).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the JSON file as-is, including \n escapes,
# wrapped in double quotes.
FIREBASE_PRIVATE_KEY=""

# NextAuth (Auth.js) — drives the Google login flow. Generate a secret with
# `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=

# Google OAuth client for sign-in. Since a Firebase project is a GCP project,
# you can reuse the OAuth client Firebase Auth creates for its Google
# provider — find it in Google Cloud Console > APIs & Services > Credentials
# (same project as FIREBASE_PROJECT_ID), or create a new OAuth Client ID
# there (type: Web application). Authorized redirect URI:
# <your-origin>/api/auth/callback/google (e.g. http://localhost:3000/api/auth/callback/google).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
